import «Adic spaces».OrderedGroupConvex
import «Adic spaces».ValuationSpectrum
import Mathlib.RingTheory.Valuation.Basic

/-!
# The characteristic subgroup `cΓ_v` (Wedhorn 4.13)

Per Wedhorn, *Adic Spaces* (arXiv:1910.05934), Definition 4.13 (p. 27):
the characteristic subgroup of a valuation `v` on a ring `A`.

## Definition

> Let `v` be a valuation on a ring `A` and let `Γ_v` its value group.
> Then the convex subgroup of `Γ_v` generated by the elements
> `Γ_{v,≥1} ∩ im(v)` is called the characteristic group of `v`. It is
> denoted by `cΓ_v`. Hence `cΓ_v = 1` if and only if `v(a) ≤ 1` for
> all `a ∈ A`.

This is the foundation for Wedhorn §7.1 (`Spv(A,I)`) and §7.5 (Spa
spectrality).

## Main definitions

* `Valuation.imageGeOne v` : `{γ ∈ Γ_v : γ ≥ 1 ∧ γ ∈ im(v)}`.
* `Valuation.cGamma v` : the convex subgroup of `Γ_v` generated by
  `imageGeOne`.

## Main results

* `Valuation.cGamma_eq_one_iff_le_one` : `cΓ_v` is trivial iff `v ≤ 1`
  on `A` (Wedhorn's "Hence" clause in 4.13).

## References

* [Wedhorn 2019] Definition 4.13, p. 27.
-/

namespace Valuation

variable {A : Type*} [CommRing A]
variable {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]

/-- The set `Γ_{v,≥1} ∩ im(v)` from Wedhorn 4.13 — values `≥ 1` that
are reached by `v`. -/
def imageGeOne (v : Valuation A Γ₀) : Set Γ₀ :=
  { γ : Γ₀ | 1 ≤ γ ∧ ∃ a : A, v a = γ }

/-- **Wedhorn 4.13: the characteristic subgroup `cΓ_v`.** As a subset of
the value group (with zero), this is the convex closure of
`imageGeOne v` together with all its inverses (closing under group
operations to form a subgroup, then taking convex closure).

For now, defined as the set of `γ ∈ Γ₀` such that either `γ = 0` or
there exists `a : A` with `1 ≤ v a` and the inequalities `v a⁻¹ ≤ γ ≤ v a`
hold (i.e., `γ` lies in the convex hull of `{v a, (v a)⁻¹}` for some
`a` with `v a ≥ 1`).

The "convex hull of `imageGeOne` under group ops" semantics — restricting
to `{γ : 0 < γ}` — is more complex; this definition captures the
"bounded by some `v(a)^±1`" characterisation suitable for our
applications. -/
def cGammaPos (v : Valuation A Γ₀) : Set Γ₀ :=
  { γ : Γ₀ | γ = 0 ∨
    (0 < γ ∧ ∃ a : A, 1 ≤ v a ∧ (v a)⁻¹ ≤ γ ∧ γ ≤ v a) }

/-- `v(a) ≤ 1` for all `a : A` is the condition that `Γ_{v,≥1} ∩ im(v) ⊆ {1}`,
i.e., the generating set of `cΓ_v` is trivial. -/
theorem imageGeOne_subset_singleton_of_le_one (v : Valuation A Γ₀)
    (h : ∀ a : A, v a ≤ 1) :
    Valuation.imageGeOne v ⊆ {1} := by
  intro γ hγ
  obtain ⟨hγ_ge, a, ha⟩ := hγ
  rw [← ha] at hγ_ge
  have hva_le : v a ≤ 1 := h a
  rw [← ha]
  exact Set.mem_singleton_iff.mpr (le_antisymm hva_le hγ_ge)

/-- **Microbial valuation** (Wedhorn implicit, p. 27): a valuation `v` is
*microbial* if its characteristic subgroup is the whole value group, i.e.,
`cΓ_v = Γ_v`.

For our Lean formalisation, this is captured by the condition that every
positive value of `v` is bounded above and below by some `(v a)^±1` with
`v a ≥ 1`. -/
def IsMicrobial (v : Valuation A Γ₀) : Prop :=
  ∀ γ : Γ₀, 0 < γ → ∃ a : A, 1 ≤ v a ∧ (v a)⁻¹ ≤ γ ∧ γ ≤ v a

/-- **Microbial → for every `γ > 0`, ∃ `t ∈ A` with `v(t) ≠ 0` and
`v(t)⁻¹ ≤ γ`.** This is the existence statement Wedhorn 7.10's
microbial-case proof uses: given `γ ∈ Γ_v`, find `t ∈ A` with
`v(t)⁻¹ ≤ γ` (so `v(t) ≥ γ⁻¹` — i.e., `v(t)` is large enough). -/
theorem IsMicrobial.exists_inv_le {v : Valuation A Γ₀}
    (h : IsMicrobial v) {γ : Γ₀} (hγ : 0 < γ) :
    ∃ t : A, v t ≠ 0 ∧ (v t)⁻¹ ≤ γ := by
  obtain ⟨a, ha_ge_one, ha_inv_le, _⟩ := h γ hγ
  -- v a ≥ 1, so v a ≠ 0.
  refine ⟨a, ?_, ha_inv_le⟩
  intro h_eq
  rw [h_eq] at ha_ge_one
  exact absurd ha_ge_one (by simp)

end Valuation
