/-- **Part (ii) sub-lemma 1**: `T · A = A` (T spans the unit ideal)
implies the "no common zero" property: every Spa-point has nonzero
valuation on at least one element of T. -/
theorem noCommonZero_of_idealGen
    (T : Finset A) (hT_span : Ideal.span (T : Set A) = ⊤) :
    ∀ v ∈ Spa A A⁺, ∃ t ∈ T, ¬ v.vle t 0 := by
  intro v _hv
  by_contra h
  push_neg at h
  -- h : ∀ t ∈ T, v.vle t 0, i.e., every t ∈ T is in v.supp.
  have h_sub : (T : Set A) ⊆ (v.supp : Set A) := by
    intro t ht
    exact (mem_supp_iff v t).mpr (h t ht)
  -- So Ideal.span T ⊆ v.supp.
  have h_le : Ideal.span (T : Set A) ≤ v.supp := Ideal.span_le.mpr h_sub
  -- But Ideal.span T = ⊤, so v.supp = ⊤.
  rw [hT_span, top_le_iff] at h_le
  -- v.supp is a prime ideal, hence ≠ ⊤.
  exact (instIsPrimeSupp v).ne_top h_le

