  refine ⟨V, fs, hV_laurent, hV_base, ?_⟩
  -- Step d: For each V_j, restriction of C to V_j is unit-gen.
  intro Vj hVj
  exact unit_gen_restriction_of_dominating_laurent C T hC_gen s hs V Vj hVj

